# Python environments / caches
.venv/
.venv-*/
__pycache__/
*.egg-info/
.pytest_cache/
.DS_Store

# Run outputs — regenerated by the CLI. Keep only the reference results used by
# scripts/compare_results.py and the profiling numbers cited in docs/BENCHMARK.md.
outputs/*
!outputs/.gitkeep
!outputs/baseline_scan/
!outputs/baseline_photo/
!outputs/final_scan/
!outputs/final_photo/
!outputs/profiles/
